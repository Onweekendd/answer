# The Dockerfile copies the whole directory into the build stage, so anything
# listed here would otherwise end up in an image layer.

# secrets and local runtime data (admin password, DB password, search key, uploads)
# Unlike .gitignore, a bare ".env" here only matches the root one.
**/.env
answer-data/
tmp/

# Scheduler credentials and local trial records
script/community/*.local.env
script/community/*.local.json
script/community/out/
script/community/*.log
deploy/docker-compose.override.yaml
deploy/local-services/

# the browser agent is a separate Python project, not part of the image
browser-use/
# the Chrome extension runs in the user's browser, not on the server; the new web
# front end is built inside the image (the web-builder stage), so only its sources go in
frontend/extension/
frontend/**/node_modules/
frontend/web/dist/

# local build and editor leftovers
.git/
.vscode/
*.exe
*.db
ui/node_modules/
