# 复制成 .env 再填写。.env 已经被 .gitignore 忽略，不会进 git。

# 要部署的镜像 tag，CI 部署时会传 git commit 号
TAG=latest

# 宿主机上对外的端口，不写默认 8080。本机测试时 8080 被占用就换一个，比如 8090
# ANSWER_PORT=8080

# PostgreSQL 密码，安装向导里填同一个值。生成方法：openssl rand -base64 24
DB_PASSWORD=

# 浏览器 Hub 的 token，插件 popup 里要填同一个。生成：openssl rand -hex 16
BROWSER_HUB_TOKEN=
