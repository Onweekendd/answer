# 复制成 .env 再填写。.env 已经被 .gitignore 忽略，不会进 git。

# 要部署的镜像 tag，CI 部署时会传 git commit 号
TAG=latest

# 宿主机上对外的端口，不写默认 8080。本机测试时 8080 被占用就换一个，比如 8090
# ANSWER_PORT=8080

# PostgreSQL 密码，安装向导里填同一个值。生成方法：openssl rand -base64 24
DB_PASSWORD=

# 浏览器 Hub 的 token，插件 popup 里要填同一个。生成：openssl rand -hex 16
BROWSER_HUB_TOKEN=

# Garage 对象存储（Agent 存的图）。留空即可：deploy.sh 第一次部署时会生成并写进 .env。
# 手动生成：GARAGE_RPC_SECRET 用 openssl rand -hex 32；
# S3_ACCESS_KEY_ID 是 GK 加 24 位十六进制（echo GK$(openssl rand -hex 12)）；S3_SECRET_ACCESS_KEY 用 openssl rand -hex 32
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
